# These are set as Firebase secrets, NOT committed .env values:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set IG_ACCESS_TOKEN
#   firebase functions:secrets:set IG_USER_ID
#   firebase functions:secrets:set META_APP_ID
#   firebase functions:secrets:set META_APP_SECRET
#   firebase functions:secrets:set TELEGRAM_BOT_TOKEN
#   firebase functions:secrets:set TELEGRAM_CHAT_ID
#
# This file documents what each one is:
#
# ANTHROPIC_API_KEY   - Claude API key (captions)
# OPENAI_API_KEY      - OpenAI key (gpt-image-1 visuals)
# IG_ACCESS_TOKEN     - long-lived Instagram Graph API token (seed value)
# IG_USER_ID          - Instagram Business account ID (numeric)
# META_APP_ID         - Meta developer app ID (for token refresh)
# META_APP_SECRET     - Meta developer app secret (for token refresh)
# TELEGRAM_BOT_TOKEN  - bot token from @BotFather
# TELEGRAM_CHAT_ID    - your Telegram chat/user ID for approvals
